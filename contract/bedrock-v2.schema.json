{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bedrock-v2.schema.json",
  "title": "Bedrock v2 act (DRAFT)",
  "description": "One act node: a verb or structural act with its lineage envelope and verb-specific payload. Records and their states are projected from acts. See contract/bedrock-v2.md.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/id_act"
    },
    "protocol": {
      "enum": [
        "2.0.0",
        "2.1.0"
      ],
      "description": "The Bedrock language version the act was recorded under; 2.1.0 is additive, so acts recorded under 2.0.0 stay valid."
    },
    "verb": {
      "$ref": "#/$defs/verb"
    },
    "level": {
      "$ref": "#/$defs/level"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "session": {
      "$ref": "#/$defs/pointer"
    },
    "turn": {
      "$ref": "#/$defs/pointer"
    },
    "tool_call": {
      "$ref": "#/$defs/pointer"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "batch": {
      "type": "string",
      "minLength": 1
    },
    "edit_window_closes_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "protocol",
    "verb",
    "level",
    "scope",
    "recorded_at",
    "actor",
    "session",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verb": {
            "const": "stipulate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_stipulate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "declare"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_declare"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "formulate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_formulate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "evaluate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_evaluate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "decide"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_decide"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "mint"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_mint"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "define"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_define"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "produce"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_produce"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "refine"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_refine"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "judge"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_judge"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "revoke"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_revoke"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "supersede"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_supersede"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "store"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_store"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "group"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_group"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "regroup"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_regroup"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "relate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_relate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "amend"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_amend"
          }
        }
      }
    }
  ],
  "$defs": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "At most 256 characters; aim for one line."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "At most 1024 characters: statements, rules, hypotheses, why, scope, inputs, reasons, notes."
    },
    "result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "At most 512 characters: a Witness's observed result."
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "An opaque pointer: a session, turn or tool call in the transcript store, a path, a URN or a URL."
    },
    "level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "examples": [
        "board",
        "repository",
        "system",
        "organisation",
        "bedrock"
      ],
      "description": "Where the act applies. Initial values in examples; an organisation may add values."
    },
    "id_Invariant": {
      "type": "string",
      "pattern": "^I-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Gap": {
      "type": "string",
      "pattern": "^G-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Candidate": {
      "type": "string",
      "pattern": "^C-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Decision": {
      "type": "string",
      "pattern": "^D-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Promise": {
      "type": "string",
      "pattern": "^P-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Oracle": {
      "type": "string",
      "pattern": "^O-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Witness": {
      "type": "string",
      "pattern": "^W-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Reference": {
      "type": "string",
      "pattern": "^R-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_Plan": {
      "type": "string",
      "pattern": "^PLAN-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_act": {
      "type": "string",
      "pattern": "^A-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/id_Invariant"
        },
        {
          "$ref": "#/$defs/id_Gap"
        },
        {
          "$ref": "#/$defs/id_Candidate"
        },
        {
          "$ref": "#/$defs/id_Decision"
        },
        {
          "$ref": "#/$defs/id_Promise"
        },
        {
          "$ref": "#/$defs/id_Oracle"
        },
        {
          "$ref": "#/$defs/id_Witness"
        },
        {
          "$ref": "#/$defs/id_Reference"
        }
      ]
    },
    "id_plan_member": {
      "description": "A Plan member: a Candidate, a Promise or a Gap, nothing else.",
      "anyOf": [
        {
          "$ref": "#/$defs/id_Candidate"
        },
        {
          "$ref": "#/$defs/id_Promise"
        },
        {
          "$ref": "#/$defs/id_Gap"
        }
      ]
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^scope:[a-z][a-z0-9_-]*/.+$",
      "description": "scope:<level>/<scope name>"
    },
    "applies_to": {
      "description": "What an Invariant or Promise binds: all environments (the default when absent) or a version scope, a system-level scope such as agent-runtime/2. In the domain it is the making act's level and scope; in a record file it is the heading Applies to.",
      "anyOf": [
        {
          "const": "all environments"
        },
        {
          "type": "string",
          "pattern": "^\\S+$",
          "minLength": 1,
          "maxLength": 256
        }
      ]
    },
    "state": {
      "type": "object",
      "description": "Projected state of a record, by noun: the past tense of the last standing verb applied to it (a Promise is asserted or assured). Derived from acts, never written.",
      "properties": {
        "Invariant": {
          "enum": [
            "stipulated",
            "superseded",
            "revoked"
          ]
        },
        "Gap": {
          "enum": [
            "declared",
            "decided",
            "superseded",
            "revoked"
          ]
        },
        "Candidate": {
          "enum": [
            "formulated",
            "evaluated",
            "decided",
            "superseded",
            "revoked"
          ]
        },
        "Decision": {
          "enum": [
            "decided",
            "superseded",
            "revoked"
          ]
        },
        "Promise": {
          "enum": [
            "asserted",
            "assured",
            "superseded",
            "revoked"
          ]
        },
        "Oracle": {
          "enum": [
            "defined",
            "superseded",
            "revoked"
          ]
        },
        "Witness": {
          "enum": [
            "produced",
            "judged",
            "revoked"
          ]
        },
        "Reference": {
          "enum": [
            "stored",
            "superseded",
            "revoked"
          ]
        },
        "Plan": {
          "enum": [
            "grouped",
            "regrouped",
            "revoked"
          ]
        }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "tool"
          ]
        },
        "agent": {
          "$ref": "#/$defs/pointer"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Stamped by the runtime; never set by the agent; not enforced."
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "description": "Stamped from the caller's key."
        }
      },
      "required": [
        "kind",
        "agent"
      ],
      "additionalProperties": false
    },
    "invariant": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Invariant"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "rule": {
          "$ref": "#/$defs/text"
        },
        "priority": {
          "enum": [
            "critical",
            "standard"
          ]
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        }
      },
      "required": [
        "id",
        "title",
        "rule",
        "priority"
      ],
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Gap"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "statement"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Candidate"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "hypothesis": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "hypothesis"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Decision"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alternative": {
                "$ref": "#/$defs/title"
              },
              "why": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "alternative",
              "why"
            ],
            "additionalProperties": false
          }
        },
        "revisit_when": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "why"
      ],
      "additionalProperties": false
    },
    "promise": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Promise"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "residual": {
          "$ref": "#/$defs/text"
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "scope"
      ],
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Oracle"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "judges": {
          "$ref": "#/$defs/id_Promise"
        },
        "inputs": {
          "$ref": "#/$defs/text"
        },
        "holds_when": {
          "$ref": "#/$defs/text"
        },
        "fails_when": {
          "$ref": "#/$defs/text"
        },
        "arrangement": {
          "enum": [
            "human",
            "agent",
            "deterministic",
            "mixed"
          ]
        },
        "executable": {
          "$ref": "#/$defs/pointer"
        }
      },
      "required": [
        "id",
        "title",
        "judges",
        "inputs",
        "holds_when",
        "fails_when",
        "arrangement"
      ],
      "additionalProperties": false
    },
    "witness": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Witness"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "observes": {
          "$ref": "#/$defs/id_Promise"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "coordinate": {
          "$ref": "#/$defs/title"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id_Reference"
          }
        }
      },
      "required": [
        "id",
        "title",
        "observes",
        "observed_at",
        "coordinate",
        "result",
        "evidence"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Reference"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "kind": {
          "enum": [
            "artifact",
            "repository_file",
            "website"
          ]
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$",
          "description": "First slice: text/markdown for stored artifacts and extractions."
        },
        "digest": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sha256"
          ],
          "additionalProperties": false
        },
        "location": {
          "type": "object"
        },
        "conversion": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "tool_version": {
              "type": "string",
              "minLength": 1
            },
            "converted_at": {
              "type": "string",
              "format": "date-time"
            },
            "from_media_type": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "#/$defs/id_Reference",
              "description": "Only where an original is kept; a website's source is its location url."
            }
          },
          "required": [
            "tool",
            "tool_version",
            "converted_at",
            "from_media_type"
          ],
          "additionalProperties": false,
          "description": "Required on a website Reference: tool, tool_version, converted_at, from_media_type."
        },
        "visibility": {
          "type": "string",
          "minLength": 1,
          "default": "shared",
          "description": "Organisation-defined value. Optional on a store act; always present on the stored Reference (the tool fills the default)."
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "media_type",
        "location"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "artifact"
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ],
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "stored": {
                    "type": "object",
                    "properties": {
                      "store": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "store",
                      "key",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "stored"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repository_file"
              }
            }
          },
          "then": {
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,64}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "repository",
                  "commit",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "website"
              }
            }
          },
          "then": {
            "required": [
              "digest",
              "conversion"
            ],
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "retrieved_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "stored": {
                    "type": "object",
                    "properties": {
                      "store": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "store",
                      "key",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "url",
                  "retrieved_at",
                  "stored"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "stored_reference": {
      "description": "A Reference as stored and projected: visibility is always present.",
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        }
      ],
      "required": [
        "visibility"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id_Plan"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id_plan_member"
          }
        },
